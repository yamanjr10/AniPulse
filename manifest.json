{
  "name": "AniPulse",
  "short_name": "AniPulse",
  "description": "Track your anime watchlist and manage your anime journey",
  "start_url": "/dashboard.html",
  "display": "standalone",
  "theme_color": "#6366F1",
  "background_color": "#0B1120",
  "orientation": "portrait",
  "scope": "/",
  "icons": [
    {
      "src": "icon/icon.png",
      "sizes": "any",
      "type": "image/jpeg"
    }
  ],
  "shortcuts": [
    {
      "name": "Watchlist",
      "short_name": "Watchlist",
