      "icons": [{ "src": "/icon/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Statistics",
      "short_name": "Stats",
      "description": "View your anime statistics",
      "url": "/dashboard.html?page=statistics",
      "icons": [{ "src": "/icon/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Add Anime",
      "short_name": "Add",
      "description": "Add a new anime to your list",
      "url": "/dashboard.html?action=add",
      "icons": [{ "src": "/icon/icon-96x96.png", "sizes": "96x96" }]
    }
  ]
}
